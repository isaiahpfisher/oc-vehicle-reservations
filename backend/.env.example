DB_HOST=localhost
DB_USER=root
DB_PW=
DB_NAME=vehicles-db
AUTH_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
# Feature 8: Google key for trip mileage, destination distance, and address search. Enable "Routes API" and "Places API (New)"
# on the key's project; no HTTP-referrer restriction. Without it, addresses and miles are typed in, and only trips to a single
# saved destination get a mileage estimate (the rest show "Unknown").
GOOGLE_MAPS_API_KEY=
# CAMPUS_ADDRESS=Oklahoma Christian University, 2501 E Memorial Rd, Edmond, OK 73013
PORT=3200
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true
# Development-only sign-in as any existing user (Feature 3 FR-014): true to enable.
# Ignored when NODE_ENV=production. Every account's password is DEV_LOGIN_PASSWORD (default "password").
DEV_LOGIN=false
# DEV_LOGIN_PASSWORD=password
